<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
   version="4.0">
    
    <display-name>PTFMS</display-name>

    <!-- VehicleController Servlet -->
    <servlet>
        <servlet-name>VehicleController</servlet-name>
        <servlet-class>controller.VehicleController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>VehicleController</servlet-name>
        <url-pattern>/VehicleController</url-pattern>
    </servlet-mapping>

    <!-- UserController Servlet -->
    <servlet>
        <servlet-name>UserController</servlet-name>
        <servlet-class>controller.UserController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UserController</servlet-name>
        <url-pattern>/UserController</url-pattern>
    </servlet-mapping>

    <!-- MaintenanceController Servlet -->
    <servlet>
        <servlet-name>MaintenanceController</servlet-name>
        <servlet-class>controller.MaintenanceController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>MaintenanceController</servlet-name>
        <url-pattern>/MaintenanceController</url-pattern>
    </servlet-mapping>
    
     <!-- Route Servlet -->
    <servlet>
        <servlet-name>RouteController</servlet-name>
        <servlet-class>controller.RouteController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RouteController</servlet-name>
        <url-pattern>/RouteController</url-pattern>
    </servlet-mapping>

    <!-- Welcome file -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>
    
</web-app>
